{
  "name": "weave-agent-workflow",
  "version": "0.6.3",
  "description": "Zero-dependency context & token optimizer for Claude Code, Codex CLI, and Google Antigravity. Cuts terminal output by up to 96.4% to prevent context window exhaustion.",
  "keywords": [
    "claude-code",
    "claude",
    "codex",
    "antigravity-cli",
    "gemini",
    "mcp",
    "mcp-server",
    "token-saver",
    "context-window",
    "token-optimization",
    "context-compression",
    "terminal",
    "ai-coding",
    "ai-agent",
    "llm-tools",
    "developer-tools",
    "cost-reduction",
    "workflow",
    "orchestration",
    "verification",
    "opencode"
  ],
  "author": "Gabriel Costa",
  "license": "MIT",
  "homepage": "https://github.com/GabrielKqw/weave",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GabrielKqw/weave.git"
  },
  "bugs": {
    "url": "https://github.com/GabrielKqw/weave/issues"
  },
  "type": "commonjs",
  "bin": {
    "weave": "cli/weave.js"
  },
  "files": [
    "cli",
    "core",
    "hooks",
    "skills",
    "mcp",
    "commands",
    "plugins",
    "opencode.json",
    ".opencode",
    ".claude-plugin",
    ".codex-plugin",
    ".agents",
    "GEMINI.md",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test",
    "benchmark": "node scripts/benchmark.js",
    "generate:rules": "node scripts/generate-agent-rules.js",
    "generate:chart": "node scripts/generate-benchmark-chart.js",
    "check": "npm test && node cli/weave.js doctor && node scripts/generate-agent-rules.js --check && node scripts/generate-benchmark-chart.js --check"
  },
  "engines": {
    "node": ">=18"
  }
}
